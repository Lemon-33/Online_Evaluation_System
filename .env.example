# CloudBase Web 端环境变量（参考）
# 用法：复制为 .env.local，按实际情况修改

# 你的环境 ID
VITE_TCB_ENV=lhr20000711-d0gfnvzhdf1b2802d
VITE_TCB_REGION=ap-shanghai

# 部署到子路径时配置，例如 /evaluation/
VITE_PUBLIC_BASE=./

# 本地 mock
#   true  = 不调用 CloudBase，用户数据与评价数据都存 localStorage（离线调试用）
#   false = 走真实云函数 + PostgreSQL
VITE_USE_MOCK=true

# ============================================================
# 注意：PostgreSQL 连接串【不要】写在这里！
# 它属于服务端密钥，写进前端会被打包公开。
# 正确位置：CloudBase 控制台 → 云函数 → userService → 函数配置 → 环境变量
#   PG_CONNECTION_STRING = postgresql://用户名:密码@主机:5432/数据库名
#   PG_SSL               = true   # 仅当使用公网地址连接时需要
# ============================================================
