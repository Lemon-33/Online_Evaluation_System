# 前端环境变量（参考）
# 用法：复制为 .env.local，按实际情况修改

# 后端 API 地址
#   生产环境：前端（nginx 静态托管）与后端同域，留空即可，直接请求 /api/...
#   本地开发：指向本地后端，例如 VITE_API_BASE=http://localhost:3000
VITE_API_BASE=

# 部署到子路径时配置，例如 /evaluation/
VITE_PUBLIC_BASE=./

# 本地 mock
#   true  = 不连后端，用户数据与评价数据都存 localStorage（离线调试用）
#   false = 调用真实后端（Express + SQLite）
VITE_USE_MOCK=true
